{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cirklon2 Desktop App",
  "version": "0.9.0",
  "identifier": "com.lftherios.cirklon2desktopapp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cirklon2 Desktop App",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
